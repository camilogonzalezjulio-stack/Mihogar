# Copia este archivo como .env y llena los valores de tu app web de Firebase
# (Consola > Configuración del proyecto > Tus apps > Configuración del SDK).
# Si VITE_FIREBASE_API_KEY queda vacío, la app funciona solo con el navegador y sin inicio de sesión.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Los usuarios se crean en Firebase como <usuario>@VITE_USER_DOMAIN
VITE_USER_DOMAIN=mihogar.test

# --- Recordatorios (solo para `npm run notify`; NO llevan VITE_, así que nunca llegan a la página) ---
# En producción van como secretos de GitHub Actions, no aquí.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
APP_URL=
