rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo estos usuarios (creados en Authentication) pueden entrar.
    function permitido() {
      return request.auth != null
        && request.auth.token.email in [
          'camilo@mihogar.test',
          'sofia@mihogar.test'
        ];
    }

    // Datos compartidos de la casa: servicios, recibos, compras y secciones de compras.
    // `list` va aparte: la app escucha la colección completa y en una consulta no se conoce `doc`.
    match /homes/main/data/{doc} {
      allow list: if permitido();
      allow get, write: if permitido() && doc in ['services', 'bills', 'shopping', 'shopcats'];
    }
    match /homes/main/receipts/{doc} {
      allow read, write: if permitido();
    }

    // Finanzas personales: solo el dueño de la cuenta puede leerlas o escribirlas.
    match /homes/main/private/{userId}/data/{doc} {
      allow list: if permitido() && request.auth.uid == userId;
      allow get, write: if permitido() && request.auth.uid == userId && doc in ['people', 'tx'];
    }
  }
}
